<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".ui.activity.SignupActivity">

        <ImageView
            android:layout_width="415dp"
            android:layout_height="357dp"
            android:src="@drawable/bg_mountain_blue" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="87dp"
            android:layout_height="75dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="180"
            app:srcCompat="@drawable/bg_mountain_green"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="382dp" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="41dp"
            tools:layout_editor_absoluteY="225dp" />


    <EditText
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:background="@drawable/button_background"
        android:hint="name"
        android:paddingLeft="20dp"
        app:layout_editor_absoluteX="41dp"
        app:layout_editor_absoluteY="290dp"
        tools:layout_editor_absoluteX="41dp"
        tools:layout_editor_absoluteY="284dp" />

    <EditText
            android:layout_width="300dp"
            android:layout_height="48dp"
            app:layout_editor_absoluteX="41dp"
            app:layout_editor_absoluteY="345dp"
            android:background="@drawable/button_background"
            android:hint="email"
            android:paddingLeft="20dp"
            />

        <EditText
            android:layout_width="300dp"
            android:layout_height="48dp"
            app:layout_editor_absoluteX="41dp"
            app:layout_editor_absoluteY="405dp"
            android:background="@drawable/button_background"
            android:hint="password"
            android:paddingLeft="20dp"
            />

    <Button
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:background="@drawable/button_background"
        android:text="Sign Up"
        tools:layout_editor_absoluteX="133dp"
        tools:layout_editor_absoluteY="511dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go to Login"
        android:textColor="@color/white"
        android:textSize="13sp"
        tools:layout_editor_absoluteX="158dp"
        tools:layout_editor_absoluteY="554dp" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/white"
        android:text="I agree to the terms and conditions."
        android:textColor="@color/white"
        tools:layout_editor_absoluteX="41dp"
        tools:layout_editor_absoluteY="467dp" />

</androidx.constraintlayout.widget.ConstraintLayout>