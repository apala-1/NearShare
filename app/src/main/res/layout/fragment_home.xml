<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.Fragment.HomeFragment">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="42dp"
        android:layout_height="80dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/notificationbell" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="27dp"
        android:layout_marginTop="27dp"
        android:fontFamily="@font/plusjakartasans"
        android:text="Hi, John Doe"
        android:textColor="#011C38"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profile_image"
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <TextView
        android:id="@+id/work"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="49dp"
        android:text="Architect"
        android:textColor="#565656"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/profile_image"
        app:layout_constraintTop_toBottomOf="@+id/mail" />

    <TextView
        android:id="@+id/mail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="49dp"
        android:layout_marginTop="6dp"
        android:text="johndoe@email.com"
        android:textColor="#565656"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/profile_image"
        app:layout_constraintTop_toBottomOf="@+id/name" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="49dp"
        android:layout_marginTop="118dp"
        android:fontFamily="@font/opensans"
        android:text="John Doe"
        android:textColor="#011C38"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/profile_image"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/receiveBtn"
        android:layout_width="128dp"
        android:layout_height="42dp"
        android:layout_marginStart="59dp"
        android:layout_marginTop="78dp"
        android:background="@drawable/sharing_btn_bg"
        android:fontFamily="@font/plusjakartasans"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="Receive Files"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/button2"
        app:layout_constraintTop_toBottomOf="@+id/work" />

    <Button
        android:id="@+id/button2"
        android:layout_width="128dp"
        android:layout_height="42dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="26dp"
        android:background="@drawable/sharing_btn_bg"
        android:fontFamily="@font/plusjakartasans"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="Tap to share"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_image" />

    <ImageView
        android:id="@+id/bgBlue"
        android:layout_width="320dp"
        android:layout_height="150dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/blueno_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button2" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDevices"
        android:layout_width="290dp"
        android:layout_height="70dp"
        android:layout_marginStart="58dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/blueno_border"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/receiveBtn" />

    <ImageView
        android:id="@+id/achievements"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bgBlue"
        app:srcCompat="@drawable/backbgblue" />

    <ImageView
        android:id="@+id/activity"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="80dp"
        app:layout_constraintStart_toEndOf="@+id/achievements"
        app:layout_constraintTop_toBottomOf="@+id/bgBlue"
        app:srcCompat="@drawable/backbgblue" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="19dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/opensans"
        android:text="Recent Transfers"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/achievements"
        app:layout_constraintTop_toBottomOf="@+id/imageView6" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="@+id/achievements"
        app:layout_constraintTop_toTopOf="@+id/achievements"
        app:srcCompat="@drawable/baseline_history_24" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="@+id/activity"
        app:layout_constraintTop_toTopOf="@+id/activity"
        app:srcCompat="@drawable/baseline_emoji_events_24" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="29dp"
        android:layout_marginTop="2dp"
        android:text="Achievements"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/activity"
        app:layout_constraintTop_toBottomOf="@+id/imageView7" />

    <TextView
        android:id="@+id/quick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="35dp"
        android:fontFamily="@font/plusjakartasans"
        android:text="Quick Access"
        android:textColor="#001667"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bgBlue" />

    <TextView
        android:id="@+id/contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact Information"
        android:fontFamily="@font/opensans"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        tools:layout_editor_absoluteX="60dp"
        tools:layout_editor_absoluteY="358dp" />


</androidx.constraintlayout.widget.ConstraintLayout>